<!doctype html><html lang="en"><head><%- include("partials/head", {title:"Your Daily Drip Pass"}) %></head><body><main class="shell narrow"><a class="back" href="/">THE DAILY DRIP</a><section class="pass-card"><div class="pass-top"><div class="brand light">THE DAILY DRIP</div><div class="eyebrow light-text">AN EXCLUSIVE INVITATION</div><div class="rule"></div><div class="eyebrow light-text">YOUR DAILY DRIP PASS</div><h1 class="pass-title"><%= offerTitle %></h1><p class="pass-copy"><%= offerDescription %></p><div class="qr-wrap"><img src="<%= qr %>" alt="QR code for your pass"></div><div class="pass-code"><%= pass.code %></div><div class="status <%= pass.redeemed_at ? 'used' : 'valid' %>"><%= pass.redeemed_at ? 'REDEEMED' : 'READY TO REDEEM' %></div></div><div class="pass-bottom"><div><span class="tiny">ISSUED TO</span><strong><%= pass.name %></strong></div><div><span class="tiny">VALID UNTIL</span><strong><%= validUntil %></strong></div></div></section><p class="muted center small">Show this pass to the team at <%= cafeAddress %>. Each pass can be used once.</p><a class="button outline full" href="<%= url %>">Refresh pass status</a><p class="tiny center">Keep this link safe. Your pass is linked to your mobile number.</p></main></body></html>